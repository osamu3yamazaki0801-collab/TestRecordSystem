# === 必須環境変数 ===

# Flask アプリケーションのシークレットキー (32文字以上のランダムな値)
# 例: openssl rand -hex 16 で生成可能
LEDGER_SECRET_KEY=your-32-character-random-secret-key-here

# === Microsoft Graph API (メール送信機能) ===
# Azure Entra ID でアプリケーション登録して以下の情報を取得してください
# 参考: https://learn.microsoft.com/ja-jp/entra/identity-platform/quickstart-register-app

# Azure Entra ID テナントID
AZURE_TENANT_ID=your-tenant-id

# アプリケーション (クライアント) ID
AZURE_CLIENT_ID=your-client-id

# クライアント シークレット
AZURE_CLIENT_SECRET=your-client-secret

# メール送信用のメールボックス (共有メールボックス推奨)
# 例: test-record-system@toshiba.co.jp
GRAPH_MAILBOX_EMAIL=your-system-mailbox@example.com
